{% extends "template_job.html.twig" %}

{% block body %}
	{% include "/composants/search.html.twig" %}

	<!-- About Start -->
	<div class="container-xxl py-5">
		<div class="container">
			<div class="row g-5 align-items-center">
				<div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
					<h1 class="mb-4">We Help You Find the Best Job That Fits Your Future</h1>
					<p class="mb-4">PolyJob is a modern platform designed to connect talented candidates with employers who value skills, ambition, and growth.</p>
					<p class="mb-4">Whether you are looking for your first job, a better opportunity, or a fresh start, we make the process simple, fast, and transparent.</p>
					<div class="row g-3 mb-4">
						<div class="col-sm-6">
							<div class="d-flex align-items-center border-start border-5 border-primary px-3">
								<h2 class="flex-shrink-0 mb-0" data-toggle="counter-up">10</h2>
								<div class="ps-4">
									<p class="mb-0">Years</p>
									<h6 class="text-uppercase mb-0">Experience</h6>
								</div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="d-flex align-items-center border-start border-5 border-primary px-3">
								<h2 class="flex-shrink-0 mb-0" data-toggle="counter-up">500</h2>
								<div class="ps-4">
									<p class="mb-0">More</p>
									<h6 class="text-uppercase mb-0">Jobs</h6>
								</div>
							</div>
						</div>
					</div>
					<a class="btn btn-primary py-3 px-5 mt-3" href="{{ path('app_accueil') }}">Explore Jobs</a>
				</div>
				<div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
					<img class="img-fluid rounded" src="{{ asset('img/about-1.jpg') }}" alt="About PolyJob">
				</div>
			</div>
		</div>
	</div>
	<!-- About End -->

	<!-- Why Choose Us Start -->
	<div class="container-xxl py-5">
		<div class="container">
			<div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
				<h1 class="mb-3">Why Choose Us</h1>
				<p>We believe the right job should be accessible, fair, and aligned with your ambitions.</p>
			</div>
			<div class="row g-4">
				<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
					<div class="service-item rounded p-4 h-100">
						<i class="fa fa-3x fa-search text-primary mb-4"></i>
						<h5 class="mb-3">Smart Search</h5>
						<p class="mb-0">Find opportunities tailored to your skills, location, and preferred industry.</p>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
					<div class="service-item rounded p-4 h-100">
						<i class="fa fa-3x fa-user-tie text-primary mb-4"></i>
						<h5 class="mb-3">Top Employers</h5>
						<p class="mb-0">Connect with companies that value innovation, talent, and long-term growth.</p>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
					<div class="service-item rounded p-4 h-100">
						<i class="fa fa-3x fa-chart-line text-primary mb-4"></i>
						<h5 class="mb-3">Career Growth</h5>
						<p class="mb-0">Discover roles that help you develop professionally and move forward confidently.</p>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
					<div class="service-item rounded p-4 h-100">
						<i class="fa fa-3x fa-handshake text-primary mb-4"></i>
						<h5 class="mb-3">Trusted Support</h5>
						<p class="mb-0">Get a hiring experience built on clarity, trust, and real human support.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Why Choose Us End -->

	<!-- Team Start -->
	<div class="container-xxl py-5">
		<div class="container">
			<div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
				<h1 class="mb-3">Our Mission</h1>
				<p>We simplify the job market so people can focus on what matters most: building a career they love.</p>
			</div>
			<div class="row g-4">
				<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
					<div class="team-item rounded overflow-hidden">
						<img class="img-fluid" src="{{ asset('img/about-2.jpg') }}" alt="Mission">
						<div class="team-text bg-light text-center p-4">
							<h5 class="mb-0">Better Opportunities</h5>
							<p>Help applicants discover roles that match their strengths and aspirations.</p>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
					<div class="team-item rounded overflow-hidden">
						<img class="img-fluid" src="{{ asset('img/about-3.jpg') }}" alt="Values">
						<div class="team-text bg-light text-center p-4">
							<h5 class="mb-0">Strong Values</h5>
							<p>Build a hiring process rooted in transparency, fairness, and trust.</p>
						</div>
					</div>
				</div>
				<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
					<div class="team-item rounded overflow-hidden">
						<img class="img-fluid" src="{{ asset('img/about-4.jpg') }}" alt="Future">
						<div class="team-text bg-light text-center p-4">
							<h5 class="mb-0">Shared Growth</h5>
							<p>Connect talent and companies in a way that supports long-term success.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Team End -->
{% endblock %}
